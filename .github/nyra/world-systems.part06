+	hit_impact.top_level = true
+	hit_impact.z_as_relative = false
+	hit_impact.z_index = 4088
 	tree.current_scene.add_child(hit_impact)
 	hit_impact.global_position = world_position
 	if hit_impact.has_method("setup"):
