; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Oathwake"
run/main_scene="res://scenes/ui/IntroScreen.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"
config/main_scene="res://scenes/ui/IntroScreen.tscn"

[autoload]

AnimatedCursor="*res://scripts/ui/AnimatedCursor.gd"
ContentDB="*res://scripts/systems/ContentDB.gd"
DebugSidePanelRestorer="*res://scripts/ui/DebugSidePanelRestorer.gd"
PixelVFX="*res://scripts/effects/PixelVFX.gd"
SaveSlotManager="*res://scripts/systems/SaveSlotManager.gd"
SettingsManager="*res://scripts/systems/SettingsManager.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1600
window/size/window_height_override=900

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
