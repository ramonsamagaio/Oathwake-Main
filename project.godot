; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Oathwake"
run/main_scene="res://scenes/ui/IntroScreen.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"
config/main_scene="res://scenes/ui/IntroScreen.tscn"

[autoload]

ContentDB="*res://scripts/systems/ContentDB.gd"
SaveSlotManager="*res://scripts/systems/SaveSlotManager.gd"
GameSession="*res://scripts/game/GameSession.gd"
MultiFloorBuildManager="*res://scripts/systems/MultiFloorBuildManager.gd"
MultiFloorRuntimeBridge="*res://scripts/systems/MultiFloorRuntimeBridge.gd"
GroundFloorSurfaceManager="*res://scripts/systems/GroundFloorSurfaceManager.gd"
MultiFloorInputRouter="*res://scripts/systems/MultiFloorInputRouter.gd"
BuildingInteractionManager="*res://scripts/systems/BuildingInteractionManager.gd"
UIInteractionPolish="*res://scripts/ui/UIInteractionPolish.gd"
BuildMenuOverlay="*res://scripts/ui/BuildMenuOverlay.gd"
SettingsManager="*res://scripts/systems/SettingsManager.gd"
AnimatedCursor="*res://scripts/ui/AnimatedCursor.gd"
DebugSidePanelRestorer="*res://scripts/ui/DebugSidePanelRestorer.gd"
PixelVFX="*res://scripts/effects/PixelVFX.gd"
SFXManager="*res://scripts/audio/SFXManager.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method.mobile="forward_plus"
